# Copy to backend/.env  (never commit .env or *.key files)

PORT=3000
DB_PATH=relevo.sqlite

# --- Open Payments (live mode) ---------------------------------------------
# Without KEY_ID + PRIVATE_KEY the backend runs in simulator mode automatically.
# Get them at https://wallet.interledger-test.dev -> Settings -> Developer Keys.
OPEN_PAYMENTS_CLIENT_WALLET=https://ilp.interledger-test.dev/relevo
OPEN_PAYMENTS_KEY_ID=
OPEN_PAYMENTS_PRIVATE_KEY_PATH=./private.key
# Force the simulator even if credentials exist (demo safety net)
# RELEVO_SIMULATOR=true

# --- Merchant shown by default in the PWA ------------------------------------
MERCHANT_WALLET=https://ilp.interledger-test.dev/relevo-merchant
MERCHANT_NAME=Doña Elena - Tienda Local

# --- URLs ---------------------------------------------------------------------
# The payer's browser is redirected to PUBLIC_BACKEND_URL/api/payments/callback after
# approving in their wallet, then on to FRONTEND_URL. When testing on a phone, use your
# LAN IP or a tunnel (cloudflared / ngrok) instead of localhost.
PUBLIC_BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# How long the callback waits for funds to land before answering "pending"
VERIFY_TIMEOUT_MS=15000
